      "execution-evidence-not-invented",
      "no-command-execution-or-writes"
    ]
  },
  {
    "id": "response-order",
    "requiredChecks": [
      "wait-registered-before-action",
      "immediate-and-delayed-completion-checked",
      "unrelated-and-failed-responses-preserved",
      "abort-preserved",
      "simulation-not-browser-or-persistence-proof",
      "no-installs-or-external-writes"
    ]
  },
  {
    "id": "migration-overlap",
    "requiredChecks": [
      "stale-write-reproduced",
