{
  "name": "deepwright-repository",
  "version": "1.1.0",
  "description": "Evidence-first engineering workflows for Codex CLI and the macOS desktop app.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/aj2666/deepwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aj2666/deepwright.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "validate": "node scripts/validate-codex-compat.mjs",
    "build:tools": "npm --prefix plugins/deepwright/skills/deepwright/scripts run build",
    "test:tools": "npm --prefix plugins/deepwright/skills/deepwright/scripts run check",
    "test:evals": "node --test scripts/score-skill-evals.test.mjs scripts/verify-skill-evals.test.mjs",
    "eval:skills": "node scripts/score-skill-evals.mjs",
    "eval:artifacts": "node scripts/verify-skill-evals.mjs",
    "test": "npm run validate && npm run test:tools && npm run test:evals"
  }
}
