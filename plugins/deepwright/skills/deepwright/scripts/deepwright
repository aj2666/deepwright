#!/bin/sh
set -eu

json=false
for argument in "$@"; do
  if [ "$argument" = "--json" ]; then json=true; fi
done

if ! command -v node >/dev/null 2>&1; then
  if [ "$json" = true ]; then
    printf '%s\n' '{"tool":"deepwright","command":"doctor","ok":false,"checks":[{"id":"node","label":"Node.js","status":"fail","required":true,"detail":"Node.js was not found; install Node.js 20.19.0 or newer"}]}'
  else
    echo "Deepwright doctor: FAILED" >&2
    echo "[fail] Node.js was not found; install Node.js 20.19.0 or newer" >&2
  fi
  exit 1
fi

node_version=$(node -p 'process.versions.node' 2>/dev/null || echo unknown)
if ! node -e '
const match = /^(\d+)\.(\d+)\.(\d+)(?:-([^+]+))?(?:\+.+)?$/.exec(process.argv[1]);
if (match === null) process.exit(1);
const [major, minor, patch] = match.slice(1, 4).map(Number);
const supported = [major, minor, patch].every(Number.isSafeInteger) && (major > 20 ||
  (major === 20 && (minor > 19 ||
    (minor === 19 && (patch > 0 || (patch === 0 && match[4] === undefined))))));
process.exit(supported ? 0 : 1);
' "$node_version"; then
  if [ "$json" = true ]; then
    printf '%s\n' "{\"tool\":\"deepwright\",\"command\":\"doctor\",\"ok\":false,\"checks\":[{\"id\":\"node\",\"label\":\"Node.js\",\"status\":\"fail\",\"required\":true,\"detail\":\"Node.js $node_version is unsupported; version 20.19.0 or newer is required\"}]}"
  else
    echo "Deepwright doctor: FAILED" >&2
    echo "[fail] Node.js $node_version is unsupported; version 20.19.0 or newer is required" >&2
  fi
  exit 1
fi

scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle="$scripts_dir/dist/deepwright.mjs"

if [ ! -f "$bundle" ]; then
  if [ "$json" = true ]; then
    printf '%s\n' '{"tool":"deepwright","command":"doctor","ok":false,"checks":[{"id":"bundles","label":"CLI bundles","status":"fail","required":true,"detail":"dist/deepwright.mjs is missing"}]}'
  else
    echo "Deepwright doctor: FAILED" >&2
    echo "[fail] dist/deepwright.mjs is missing" >&2
  fi
  exit 1
fi

exec node "$bundle" "$@"
